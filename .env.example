# Environment Configuration Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit this file or .env files to version control

# ===== Supabase Configuration =====
# Get these from https://supabase.com/dashboard

# Your Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Public Supabase key (safe to expose to client)
SUPABASE_PUBLISHABLE_KEY=eyJhbGc...

# Service role key (KEEP SECRET - server-side only!)
# Only use in .server.ts files
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# ===== API Keys =====

# Lovable AI Gateway Token
# Get this from your Lovable Cloud workspace
LOVABLE_API_KEY=sk-...

# Public API Token for /api/public/ingest endpoint
# Generate a secure random token:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PUBLIC_API_TOKEN=your-secure-random-token-here

# ===== Environment Configuration =====

# Current environment: development, staging, or production
NODE_ENV=development

# Client-side visible environment variables (must start with VITE_)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGc...

# ===== Security Configuration =====

# CORS Origin - which domains can access this API
# For development: http://localhost:5173
# For production: https://your-domain.com
CORS_ORIGIN=http://localhost:5173

# ===== Optional: Analytics & Monitoring =====

# Sentry error tracking (optional)
# SENTRY_DSN=https://...@sentry.io/...

# Analytics endpoint (optional)
# ANALYTICS_ENDPOINT=https://...

# ===== Development Tools =====

# Enable detailed logging
DEBUG=news-compass:*

# Port for development server
PORT=5173
